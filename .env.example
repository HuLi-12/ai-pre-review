# GitHub
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# AI provider. Use "auto" to infer from AI_API_BASE.
# Supported values: auto, deepseek, openai, openai-compatible
AI_PROVIDER=auto
AI_API_KEY=
AI_API_BASE=https://api.deepseek.com/v1

# Models for summary and deeper file/cross-file review.
AI_MODEL=deepseek-v4-flash
AI_DEEP_MODEL=deepseek-v4-flash

# Provider safety limits.
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=800

# Local app
DATABASE_URL=sqlite:///./ai_review.db
HOST=0.0.0.0
PORT=8000
DEBUG=false
